{
  "Note": "Generated by Unreal/Tools/convert_godot_data.py from the archived Godot demo. Edit the generator or these files, never data/.",
  "Conversations": [
    {
      "Id": "opening",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Upper Cliffs, Brindle Isle. Sunrise.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "There has to be more out there than this.",
          "bCanon": true,
          "VoiceKey": "opening.01",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "...Right. Deliveries first. Maren will have my head if I'm late again.",
          "bCanon": false,
          "VoiceKey": "opening.02",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "StartQuest",
              "Arg": "morning_deliveries",
              "Amount": 1
            },
            {
              "Type": "StartQuest",
              "Arg": "elias_was_here",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "opening_done",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "maren_intro",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Don't tell me you've been staring at the horizon again.",
          "bCanon": true,
          "VoiceKey": "maren_intro.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "Only a little. The fog lifted off the eastern isles at dawn. You could see three of them.",
          "bCanon": false,
          "VoiceKey": "maren_intro.01",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "The parcels won't deliver themselves. Three today.",
          "bCanon": false,
          "VoiceKey": "maren_intro.02",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Spice tins for the Windsong Tavern. A box for Tessa, up at Skywatch Point. And seed packets for the flower terraces by the Cloud Edge.",
          "bCanon": false,
          "VoiceKey": "maren_intro.03",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "And Kieran? Stay back from the edge. I mean it.",
          "bCanon": false,
          "VoiceKey": "maren_intro.04",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "Door to door, before noon. Courier's honor.",
          "bCanon": false,
          "VoiceKey": "maren_intro.05",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AdvanceObjective",
              "Arg": "morning_deliveries:report",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "parcel_tavern",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "parcel_tessa",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "parcel_cliffs",
              "Amount": 1
            },
            {
              "Type": "TimeOfDay",
              "Arg": "Morning",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "maren_waiting",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "The tavern, Skywatch Point and the Cloud Edge. The parcels are in your satchel, not on the horizon.",
          "bCanon": false,
          "VoiceKey": "maren_waiting.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "maren_return",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "All three? And nobody complained? I'll write that down somewhere.",
          "bCanon": false,
          "VoiceKey": "maren_return.00",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Here. A morning's wages. Don't spend it all on map paper.",
          "bCanon": false,
          "VoiceKey": "maren_return.01",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "CompleteQuest",
              "Arg": "morning_deliveries",
              "Amount": 1
            }
          ]
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "The rest of the day passes the way days on Brindle Isle always do.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "Event",
              "Arg": "sunset_fade",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "maren_deed",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Kieran. Before you go. This came up from the registry this afternoon.",
          "bCanon": false,
          "VoiceKey": "maren_deed.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "That's... the deed to Grandpa's workshop.",
          "bCanon": false,
          "VoiceKey": "maren_deed.01",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "It's officially yours now. Signed and sealed.",
          "bCanon": false,
          "VoiceKey": "maren_deed.02",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "worried",
          "Text": "I've lived there half my life. It still feels like it's his.",
          "bCanon": false,
          "VoiceKey": "maren_deed.03",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Your grandfather left you more questions than answers. That seems appropriate.",
          "bCanon": true,
          "VoiceKey": "maren_deed.04",
          "Actions": []
        },
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Go home. The workshop's been waiting long enough.",
          "bCanon": false,
          "VoiceKey": "maren_deed.05",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "GiveItem",
              "Arg": "deed",
              "Amount": 1
            },
            {
              "Type": "StartQuest",
              "Arg": "hidden_workshop",
              "Amount": 1
            },
            {
              "Type": "Chapter",
              "Arg": "",
              "Amount": 2
            },
            {
              "Type": "SetFlag",
              "Arg": "deed_received",
              "Amount": 1
            },
            {
              "Type": "Autosave",
              "Arg": "",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "maren_after",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "maren",
          "Emotion": "",
          "Text": "Go home, Kieran. And get some sleep. You look like you've been reading weather logs again.",
          "bCanon": false,
          "VoiceKey": "maren_after.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "tavern_deliver",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "tavern",
          "Emotion": "",
          "Text": "Another clear day.",
          "bCanon": true,
          "VoiceKey": "tavern_deliver.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "Spice tins, from the Post House.",
          "bCanon": false,
          "VoiceKey": "tavern_deliver.01",
          "Actions": []
        },
        {
          "Speaker": "tavern",
          "Emotion": "",
          "Text": "You're Elias's grandson, right?",
          "bCanon": true,
          "VoiceKey": "tavern_deliver.02",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "skeptical",
          "Text": "Depends who is asking.",
          "bCanon": true,
          "VoiceKey": "tavern_deliver.03",
          "Actions": []
        },
        {
          "Speaker": "tavern",
          "Emotion": "",
          "Text": "Someone carrying a package.",
          "bCanon": true,
          "VoiceKey": "tavern_deliver.04",
          "Actions": []
        },
        {
          "Speaker": "tavern",
          "Emotion": "",
          "Text": "Half the folk in here will tell you the Skyfarers were a bedtime story. Your grandfather never once let them finish that argument.",
          "bCanon": false,
          "VoiceKey": "tavern_deliver.05",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "TakeItem",
              "Arg": "parcel_tavern",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "morning_deliveries:tavern",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "tavern_after",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "tavern",
          "Emotion": "",
          "Text": "That's what people say right before the weather changes, you know. 'Another clear day.'",
          "bCanon": true,
          "VoiceKey": "tavern_after.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "tessa_deliver",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "tessa",
          "Emotion": "",
          "Text": "You climbed all the way up here? You could have left it at the bottom of the steps.",
          "bCanon": false,
          "VoiceKey": "tessa_deliver.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "Courier's honor. Door to door.",
          "bCanon": false,
          "VoiceKey": "tessa_deliver.01",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "Look, though. You can see the eastern isles from up here. Grandpa used to say some of them move.",
          "bCanon": false,
          "VoiceKey": "tessa_deliver.02",
          "Actions": []
        },
        {
          "Speaker": "tessa",
          "Emotion": "",
          "Text": "Islands don't move, Kieran. The registry has had the same charts for two hundred years.",
          "bCanon": false,
          "VoiceKey": "tessa_deliver.03",
          "Actions": []
        },
        {
          "Speaker": "tessa",
          "Emotion": "",
          "Text": "One day you're going to disappear chasing one of those stories.",
          "bCanon": true,
          "VoiceKey": "tessa_deliver.04",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "laugh",
          "Text": "Then I'll send you a postcard.",
          "bCanon": false,
          "VoiceKey": "tessa_deliver.05",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "TakeItem",
              "Arg": "parcel_tessa",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "morning_deliveries:tessa",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "tessa_after",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "tessa",
          "Emotion": "",
          "Text": "Skywatch logs say clear skies all week. No moving islands. I checked.",
          "bCanon": false,
          "VoiceKey": "tessa_after.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "villager_deliver",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "villager",
          "Emotion": "",
          "Text": "The seed packets! Just in time for planting. Mind your step out here.",
          "bCanon": false,
          "VoiceKey": "villager_deliver.00",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Below the terraces, the sea of clouds rolls on toward the horizon.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "You ever wonder if we're all just looking in the wrong direction?",
          "bCanon": true,
          "VoiceKey": "villager_deliver.02",
          "Actions": []
        },
        {
          "Speaker": "villager",
          "Emotion": "",
          "Text": "Every day. Then I get back to work.",
          "bCanon": true,
          "VoiceKey": "villager_deliver.03",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "TakeItem",
              "Arg": "parcel_cliffs",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "morning_deliveries:cliffs",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "villager_after",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "villager",
          "Emotion": "",
          "Text": "Elias used to sit right there on the wall with his notebook. Said the wind out here talks if you listen.",
          "bCanon": false,
          "VoiceKey": "villager_after.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "board",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "The village bulletin board.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "'LOST: one copper kettle. Last seen near the fountain. Reward: soup.'",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "'SKYWATCH POINT reports: clear skies, steady winds. Traders expected from the north at month's end.'",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "'Storytelling night at the Windsong Tavern. No Skyfarer stories, please. — R. Finch, Village Elder'",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        }
      ]
    },
    {
      "Id": "fountain",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "The fountain's older than the village. Grandpa said the carvings on the basin aren't decorations. They're wind charts.",
          "bCanon": false,
          "VoiceKey": "fountain.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "windmill",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "The Whispermill sails never stop turning. Strong steady wind, every day of the year.",
          "bCanon": false,
          "VoiceKey": "windmill.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "workshop_locked_ch1",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "Home. The deliveries come first, though.",
          "bCanon": false,
          "VoiceKey": "workshop_locked_ch1.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "edge_warning",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "worried",
          "Text": "That's a long way down. Even I'm not that curious. Yet.",
          "bCanon": false,
          "VoiceKey": "edge_warning.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "skywatch_hint",
      "Source": "data/dialogue/windrest.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "Skywatch Point is up on the ridge. The quickest way is over the market stalls and up the old scaffolding.",
          "bCanon": false,
          "VoiceKey": "skywatch_hint.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "workshop_enter",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "Home.",
          "bCanon": false,
          "VoiceKey": "workshop_enter.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "worried",
          "Text": "Everything's exactly where he left it. Like he just stepped out to check the wind.",
          "bCanon": false,
          "VoiceKey": "workshop_enter.01",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "If the workshop's mine now... then so are his questions.",
          "bCanon": false,
          "VoiceKey": "workshop_enter.02",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:enter",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "inspect_maps",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "doubt",
          "Text": "These can't all be right. The same island, drawn in three different places...",
          "bCanon": false,
          "VoiceKey": "inspect_maps.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "'Not an error. It moved.' That's his handwriting.",
          "bCanon": false,
          "VoiceKey": "inspect_maps.01",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AddJournal",
              "Arg": "workshop_maps",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:search",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "searched_maps",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "inspect_sketches",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "Skyfarer fliers. Markings. Brass instruments I've never seen in any shop.",
          "bCanon": false,
          "VoiceKey": "inspect_sketches.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "skeptical",
          "Text": "And this... a little white creature with long feathered ears. He drew it over and over, always from far away.",
          "bCanon": false,
          "VoiceKey": "inspect_sketches.01",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AddJournal",
              "Arg": "workshop_sketches",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:search",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "searched_sketches",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "inspect_notes",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "Weather logs. Decades of them.",
          "bCanon": false,
          "VoiceKey": "inspect_notes.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "doubt",
          "Text": "Every strange wind on Brindle Isle, marked and dated. One current circled so many times the paper's worn through.",
          "bCanon": false,
          "VoiceKey": "inspect_notes.01",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AddJournal",
              "Arg": "workshop_notes",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:search",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "searched_notes",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "search_done",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "Wait. The board by the desk. It's always been loose... and the scratches around it are fresh-ish. He's been opening it.",
          "bCanon": false,
          "VoiceKey": "search_done.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "inspect_portrait",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "worried",
          "Text": "Grandpa.",
          "bCanon": false,
          "VoiceKey": "inspect_portrait.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "You always said the sky was a map too. I just never knew how to read it.",
          "bCanon": false,
          "VoiceKey": "inspect_portrait.01",
          "Actions": []
        }
      ]
    },
    {
      "Id": "inspect_instruments",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "His ancient weather instruments. He never let me touch these.",
          "bCanon": false,
          "VoiceKey": "inspect_instruments.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "laugh",
          "Text": "...He's not here to stop me now. Sorry, Grandpa.",
          "bCanon": false,
          "VoiceKey": "inspect_instruments.01",
          "Actions": []
        }
      ]
    },
    {
      "Id": "inspect_shelf",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "Atlases, almanacs, a book on Aerian script with half the pages pinned with notes. Grandpa read everything twice.",
          "bCanon": false,
          "VoiceKey": "inspect_shelf.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "compartment",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "The board lifts away. Beneath it, a hidden compartment runs the length of the floor.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "A glider. An actual glider.",
          "bCanon": false,
          "VoiceKey": "compartment.01",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "doubt",
          "Text": "These brass fittings... nothing in Windrest is made like this. Nothing anywhere is.",
          "bCanon": false,
          "VoiceKey": "compartment.02",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Beside it: a pair of antique flight goggles, and a worn leather journal.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:compartment",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "ancient_glider",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "flight_goggles",
              "Amount": 1
            },
            {
              "Type": "GiveItem",
              "Arg": "elias_journal",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "compartment_open",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "final_entry",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "The last page is dated only weeks before Elias died.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "elias",
          "Emotion": "",
          "Text": "The maps are wrong. They always have been.",
          "bCanon": true,
          "VoiceKey": "final_entry.01",
          "Actions": []
        },
        {
          "Speaker": "elias",
          "Emotion": "",
          "Text": "If you're reading this, look where the wind refuses to go.",
          "bCanon": true,
          "VoiceKey": "final_entry.02",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AddJournal",
              "Arg": "final_entry",
              "Amount": 1
            },
            {
              "Type": "Event",
              "Arg": "compass_awakens",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "compass_awakens",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "Every window's shut. Where is that wind coming from?",
          "bCanon": false,
          "VoiceKey": "compass_awakens.00",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "On the desk, the brass compass begins to move by itself.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Its needle swings past north, past east, and settles on a direction that isn't on any map.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "A wind current... off the edge of the Bluff. That's impossible.",
          "bCanon": false,
          "VoiceKey": "compass_awakens.03",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "content",
          "Text": "...Look where the wind refuses to go. Okay, Grandpa. First light.",
          "bCanon": false,
          "VoiceKey": "compass_awakens.04",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "GiveItem",
              "Arg": "brass_compass",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "hidden_workshop:journal",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "has_glider",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "compass_active",
              "Amount": 1
            },
            {
              "Type": "Event",
              "Arg": "next_morning",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "workshop_leave_night",
      "Source": "data/dialogue/workshop.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "Not in the dark. First light.",
          "bCanon": false,
          "VoiceKey": "workshop_leave_night.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "piko_meeting",
      "Source": "data/dialogue/sky.json",
      "Lines": [
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Something is sitting on the glider.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Not hiding. Not startled. Simply sitting there, as if it has always belonged.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "...Hello?",
          "bCanon": false,
          "VoiceKey": "piko_meeting.02",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "curious",
          "Text": "(curious chirp)",
          "bCanon": false,
          "VoiceKey": "piko_meeting.03",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "skeptical",
          "Text": "Where did you come from? Nobody comes up to the Bluff.",
          "bCanon": false,
          "VoiceKey": "piko_meeting.04",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "curious",
          "Text": "(Piko tilts his head. One feathered ear lifts. He does not move.)",
          "bCanon": false,
          "VoiceKey": "piko_meeting.05",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "doubt",
          "Text": "Wait. Long ears, white fur... You're the creature in Grandpa's sketches.",
          "bCanon": false,
          "VoiceKey": "piko_meeting.06",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "happy",
          "Text": "(happy trill)",
          "bCanon": false,
          "VoiceKey": "piko_meeting.07",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "You're sitting on my glider, you know.",
          "bCanon": false,
          "VoiceKey": "piko_meeting.08",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "determined",
          "Text": "(Piko settles in more comfortably.)",
          "bCanon": false,
          "VoiceKey": "piko_meeting.09",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "laugh",
          "Text": "...Fine. You can come. But if we fall, it's your fault.",
          "bCanon": false,
          "VoiceKey": "piko_meeting.10",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "SetFlag",
              "Arg": "piko_joined",
              "Amount": 1
            },
            {
              "Type": "AddJournal",
              "Arg": "piko_first",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "into_the_clouds:bluff",
              "Amount": 1
            },
            {
              "Type": "Event",
              "Arg": "piko_joins",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "launch_ready",
      "Source": "data/dialogue/sky.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "The compass points straight out past the edge. Into the open sky.",
          "bCanon": false,
          "VoiceKey": "launch_ready.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "worried",
          "Text": "Jump, then hold on and glide. Simple. Probably.",
          "bCanon": false,
          "VoiceKey": "launch_ready.01",
          "Actions": []
        }
      ]
    },
    {
      "Id": "piko_found_wind",
      "Source": "data/dialogue/sky.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "surprised",
          "Text": "Piko, your markings are glowing! And that current wasn't there a second ago.",
          "bCanon": false,
          "VoiceKey": "piko_found_wind.00",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "happy",
          "Text": "(proud chirp)",
          "bCanon": false,
          "VoiceKey": "piko_found_wind.01",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AddJournal",
              "Arg": "piko_wind",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "wind_refuses",
      "Source": "data/dialogue/sky.json",
      "Lines": [
        {
          "Speaker": "kieran",
          "Emotion": "doubt",
          "Text": "The wind... it just stops. Like it's refusing to go any further.",
          "bCanon": false,
          "VoiceKey": "wind_refuses.00",
          "Actions": []
        },
        {
          "Speaker": "piko",
          "Emotion": "determined",
          "Text": "(Piko's markings glow faintly. He stares into the fog and goes very still.)",
          "bCanon": false,
          "VoiceKey": "wind_refuses.01",
          "Actions": []
        },
        {
          "Speaker": "narrator",
          "Emotion": "",
          "Text": "Deep in the mist, the shape of an island drifts where no island should be.",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "hopeful",
          "Text": "Look where the wind refuses to go... Grandpa, what did you find?",
          "bCanon": false,
          "VoiceKey": "wind_refuses.03",
          "Actions": []
        },
        {
          "Speaker": "",
          "Emotion": "",
          "Text": "",
          "bCanon": false,
          "VoiceKey": "",
          "Actions": [
            {
              "Type": "AdvanceObjective",
              "Arg": "into_the_clouds:glide",
              "Amount": 1
            },
            {
              "Type": "AdvanceObjective",
              "Arg": "into_the_clouds:edge",
              "Amount": 1
            },
            {
              "Type": "SetFlag",
              "Arg": "demo_complete",
              "Amount": 1
            },
            {
              "Type": "Event",
              "Arg": "demo_end",
              "Amount": 1
            }
          ]
        }
      ]
    },
    {
      "Id": "fell",
      "Source": "data/dialogue/sky.json",
      "Lines": [
        {
          "Speaker": "piko",
          "Emotion": "surprised",
          "Text": "(alarmed squeak)",
          "bCanon": false,
          "VoiceKey": "fell.00",
          "Actions": []
        }
      ]
    },
    {
      "Id": "rowan_morning",
      "Source": "Unreal/Tools/dialogue/milestone_a_extra.json",
      "Lines": [
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Morning, Kieran. Mind the cliff paths today. The wind's turning early.",
          "bCanon": false,
          "VoiceKey": "rowan_morning.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "The old stories say the Skyfarers could read the wind like a map.",
          "bCanon": false,
          "VoiceKey": "rowan_morning.01",
          "Actions": []
        },
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "The old stories say a great many things. They're good stories, lad. Let them stay stories.",
          "bCanon": false,
          "VoiceKey": "rowan_morning.02",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "Don't you ever wonder what's past the clouds?",
          "bCanon": false,
          "VoiceKey": "rowan_morning.03",
          "Actions": []
        },
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Every spring I wonder if the mills will turn. That's plenty of wondering for one island.",
          "bCanon": false,
          "VoiceKey": "rowan_morning.04",
          "Actions": []
        }
      ]
    },
    {
      "Id": "rowan_inheritance",
      "Source": "Unreal/Tools/dialogue/milestone_a_extra.json",
      "Lines": [
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Maren tells me you had a letter. Elias's workshop, out on the Bluff.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.00",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "neutral",
          "Text": "He left it to me. I didn't even know he'd kept it.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.01",
          "Actions": []
        },
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Elias drew the finest maps this island ever had. It was the places he couldn't prove that worried folk.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.02",
          "Actions": []
        },
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Some doors stay shut for good reasons, Kieran.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.03",
          "Actions": []
        },
        {
          "Speaker": "kieran",
          "Emotion": "smile",
          "Text": "Or because nobody ever tried the handle.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.04",
          "Actions": []
        },
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "(sighs) You sound just like him.",
          "bCanon": false,
          "VoiceKey": "rowan_inheritance.05",
          "Actions": []
        }
      ]
    },
    {
      "Id": "rowan_repeat",
      "Source": "Unreal/Tools/dialogue/milestone_a_extra.json",
      "Lines": [
        {
          "Speaker": "rowan",
          "Emotion": "neutral",
          "Text": "Mills turning, post moving, clouds where they belong. That's how Windrest likes it.",
          "bCanon": false,
          "VoiceKey": "rowan_repeat.00",
          "Actions": []
        }
      ]
    }
  ]
}
